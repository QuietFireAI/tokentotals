{
  "id": "turnreceipt",
  "name": "TurnReceipt",
  "description": "Adds TokenTotals Turn Receipts to completed OpenClaw replies.",
  "categories": ["developer-tools"],
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "mode": {
        "type": "string",
        "enum": ["standard", "expanded"],
        "default": "standard"
      },
      "engineUrl": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    }
  }
}
