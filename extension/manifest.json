{
  "manifest_version": 3,
  "name": "TurnReceipt",
  "version": "0.1.0",
  "description": "Renders TokenTotals Turn Receipts inside supported AI chat surfaces.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://gemini.google.com/*"
  ],
  "optional_host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["gemini_adapter.js"],
      "css": ["receipt_host.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TurnReceipt"
  }
}
